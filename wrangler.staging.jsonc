{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gisela-lentz-web-staging",
  "main": "./dist/_worker.js",
  "compatibility_date": "2026-08-31",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": false,
  },
  "observability": {
    "enabled": false,
  },
}
