PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Sitekey publico del widget de Turnstile que protege el login. Se inlinea en
# el build, asi que tiene que estar presente al compilar, no al ejecutar. Sin
# este valor no se dibuja el widget y el login no manda token: dejarlo vacio
# solo mientras el CAPTCHA siga apagado en Supabase Auth. La clave secreta del
# widget no vive en este repositorio, va en el dashboard de Supabase.
PUBLIC_TURNSTILE_SITEKEY=

# Estos secretos se configuran en Supabase Edge Functions, nunca en Vercel ni en el navegador.
# Supabase inyecta SUPABASE_URL y su clave backend en las funciones desplegadas;
# ninguna service role o secret key debe agregarse con prefijo PUBLIC_.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_MEDIA_MAX_BYTES=10485760
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_MAX_BYTES=3145728
AUTOMATION_INTERNAL_SECRET=
WHATSAPP_AUTOMATION_OUTBOX_RECOVERY_SECRET=
WHATSAPP_AUTOMATION_OUTBOX_CLAIM_LIMIT=10
WHATSAPP_COEXISTENCE_INTERNAL_SECRET=
WHATSAPP_COEXISTENCE_RECOVERY_SECRET=
WHATSAPP_COEXISTENCE_CLAIM_LIMIT=5
WHATSAPP_COEXISTENCE_ITEMS_PER_RUN=100
REMINDER_CRON_SECRET=
# OpenAI se usa sólo desde whatsapp-automation para consultas administrativas
# canónicas. Nunca debe configurarse en Vercel ni con prefijo PUBLIC_.
OPENAI_API_KEY=
OPENAI_ADMINISTRATIVE_ENABLED=false

# Google Calendar vive sólo en Edge Functions. APP_BASE_URL fija el único
# retorno permitido después de OAuth; no se acepta una URL enviada por el browser.
APP_BASE_URL=http://localhost:5173
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:55321/functions/v1/google-calendar-oauth-callback
GOOGLE_CALENDAR_CRON_SECRET=

# Seguridad de desarrollo. Las automatizaciones quedan apagadas y el modo de
# prueba queda activo si estas variables faltan o tienen un valor inválido.
WHATSAPP_AUTOMATIONS_ENABLED=false
# Kill switch backend. Ausente, inválido o distinto de "true" mantiene
# Embedded Signup apagado y evita crear intentos o cargar el SDK en la UI.
WHATSAPP_EMBEDDED_SIGNUP_ENABLED=false
# Cuota diaria server-side por ADMIN + client scope. Default 10; clamp 5-50.
WHATSAPP_EMBEDDED_SIGNUP_MAX_ATTEMPTS_24H=10
WHATSAPP_TEST_MODE=true
# Lista E.164 separada por comas. Ejemplo de formato: +5491112345678,+5491198765432
WHATSAPP_TEST_ALLOWED_NUMBERS=

# Orígenes exactos autorizados para invocar Edge Functions desde un navegador.
# Configurar la URL nueva de Vercel; no usar comodines.
APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Acceso privado: hasta tres teléfonos E.164 nominados, separados por coma. El
# personal de Gisela y, mientras dure un trabajo técnico, el de quien la asiste.
# No usar el número público del consultorio ni completar con un número supuesto.
# Sin este secreto, con una entrada mal escrita o con más de tres, nadie recibe
# la agenda privada.
WHATSAPP_OWNER_NUMBERS=
# Resumen de mañana a las 21:00 de Buenos Aires: uno por teléfono autorizado,
# cada uno sólo con un mensaje entrante verificado suyo en las últimas 24 h. No
# usa plantillas pagadas. Requiere los switches del bot y el cron de
# process-reminders.
WHATSAPP_OWNER_DAILY_SUMMARY_ENABLED=false
